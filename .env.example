# Copy this file to .env and fill in your real Stripe keys.
# Get them from https://dashboard.stripe.com/apikeys (use the test keys
# first — they start with sk_test_ / pk_test_ — then switch to the live
# sk_live_ key only once you're ready to accept real payments).

# Secret key — server-side only, NEVER put this in frontend code or commit it.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Port the server listens on (optional, defaults to 3000).
PORT=3000
